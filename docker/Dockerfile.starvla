# syntax=docker/dockerfile:1.4
###############################################################################
# starVLA policy server: standalone GPU image (NO ROS).
#
# Hosts starVLA's own websocket policy server
# (libs/starvla/deployment/model_server/server_policy.py). The Rosetta ROS side
# (`backend:=starvla`) is a websocket client in the `default` pixi env and talks
# to this server over the network. This image carries only starVLA's torch-2.6 /
# CUDA stack and shares nothing with the ROS workspace.
#
# Needs an NVIDIA GPU at run time (flash-attn / CUDA inference). It cannot run on
# a machine without an NVIDIA driver (e.g. Apple Silicon).
#
# Build (context = repo root, so libs/starvla is available):
#   docker build -f docker/Dockerfile.starvla -t rosetta-starvla-server .
#
# Run (serve a checkpoint on port 10093):
#   docker run --rm --gpus all -p 10093:10093 \
#       -v /abs/path/to/checkpoints:/ckpts \
#       rosetta-starvla-server \
#       --ckpt_path /ckpts/<run>/checkpoints/<step>_pytorch_model.pt --port 10093 --use_bf16
#
# The entrypoint is Rosetta's server wrapper (scripts/rosetta_starvla_server.py),
# which normalizes input proprioception server-side via the training transform,
# so the ROS client can send raw state without train/deploy skew. For a stock
# (vision+language-only) server use starVLA's deployment/model_server/server_policy.py.
#
# Then on the robot:
#   pixi run ros2 launch rosetta rosetta_client_launch.py backend:=starvla \
#       server_host:=<this-host> server_port:=10093
###############################################################################

# cu124 matches starVLA's torch==2.6.0+cu124; ubuntu22.04 ships python3.10.
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04 AS server

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-dev python3-pip git ffmpeg \
        libgl1 libglib2.0-0 ninja-build \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python

# Torch first (pinned CUDA build), so flash-attn builds against it.
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.6.0 torchvision==0.21.0 \
        --index-url https://download.pytorch.org/whl/cu124

# starVLA source (cloned via repos/libs.repos into libs/starvla).
COPY libs/starvla /opt/starvla
WORKDIR /opt/starvla

# starVLA runtime deps + editable install. flash-attn needs torch present and a
# CUDA toolchain (from the -devel base). --no-build-isolation lets it see torch.
RUN python -m pip install --no-cache-dir -r requirements.txt \
    && python -m pip install --no-cache-dir --no-build-isolation flash-attn==2.7.4.post1 \
    && python -m pip install --no-cache-dir -e .

# Rosetta's server wrapper normalizes input state via the training transform.
# Args (--ckpt_path/--port/--use_bf16) are passed at `docker run`.
COPY scripts/rosetta_starvla_server.py /opt/rosetta_starvla_server.py
ENV PYTHONPATH=/opt/starvla
ENTRYPOINT ["python", "/opt/rosetta_starvla_server.py"]
CMD ["--help"]
