{
    "editor.rulers": [100],
    "editor.tabSize": 4,
    "files.associations": {
        "*.repos": "yaml",
        "*.world": "xml",
        "*.xacro": "xml",
        "*.sdf": "xml"
    },
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "search.exclude": {
        "**/build": true,
        "**/install": true,
        "**/log": true,
        "**/.pixi": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/.pixi/envs/default/lib/python3.12/site-packages",
        "${workspaceFolder}/install/lib/python3.12/site-packages",
        "${workspaceFolder}/src/action/rosetta"
    ],
    "git.repositoryScanMaxDepth": 4,
    "git-graph.maxDepthOfRepoSearch": 4,
    "ros.distro": "jazzy",
    "ROS2.usePixiOnAllPlatforms": true,
    "ROS2.pixiRoot": "${workspaceFolder}",
    "ros.isolateEnvironment": false,
    "cmake.configureOnOpen": false,
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "cSpell.allowCompoundWords": true,
    "cSpell.words": [
        "atol",
        "bringup",
        "buildx",
        "cudnn",
        "devcontainer",
        "draccus",
        "einops",
        "empy",
        "feetech",
        "gymnasium",
        "imageio",
        "lekiwi",
        "lerobot",
        "mcap",
        "ndarray",
        "pusht",
        "pyarrow",
        "pyserial",
        "rclpy",
        "robostack",
        "rosbag",
        "rosdep",
        "rosidl",
        "smolvla",
        "teleop",
        "trimesh",
        "vcstool",
        "wandb",
        "xacro",
        "yourdfpy",
        "zenoh",
        "zenohd"
    ]
}
