{
    // Thin wrappers around pixi tasks — the single source of truth is
    // pixi.toml. Run `pixi task list` to see everything available.
    "version": "2.0.0",
    "tasks": [
        // ════════════════════════════════════════════════════════════════════
        // BUILD
        // ════════════════════════════════════════════════════════════════════
        {
            "label": "build",
            "detail": "colcon build of the default env overlay (install/)",
            "type": "shell",
            "command": "pixi run build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build (select mixin)",
            "detail": "Build with a colcon mixin (debug, release, asan, ...)",
            "type": "shell",
            "command": "pixi run build --mixin ${input:buildMixin}",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build package",
            "detail": "Build a specific package",
            "type": "shell",
            "command": "pixi run build --packages-select ${input:packageName}",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build with tests",
            "detail": "Build with BUILD_TESTING enabled",
            "type": "shell",
            "command": "pixi run build-with-tests",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },

        // ════════════════════════════════════════════════════════════════════
        // TEST
        // ════════════════════════════════════════════════════════════════════
        {
            "label": "test",
            "detail": "colcon test + test-result",
            "type": "shell",
            "command": "pixi run test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "test package",
            "detail": "Run tests for a specific package",
            "type": "shell",
            "command": "pixi run test --packages-select ${input:packageName}",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "test rosetta (pytest)",
            "detail": "Run pytest directly for rosetta",
            "type": "shell",
            "command": "pixi run python -m pytest src/action/rosetta/tests -v",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "test results",
            "detail": "View test results",
            "type": "shell",
            "command": "pixi run colcon test-result --all --verbose",
            "group": "test",
            "problemMatcher": []
        },

        // ════════════════════════════════════════════════════════════════════
        // CLEAN / LINT
        // ════════════════════════════════════════════════════════════════════
        {
            "label": "clean",
            "detail": "Remove build/install/log for both overlays",
            "type": "shell",
            "command": "pixi run clean",
            "problemMatcher": []
        },
        {
            "label": "lint",
            "detail": "ament_flake8 + pep257 + xmllint over src/action",
            "type": "shell",
            "command": "pixi run lint",
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
            "problemMatcher": []
        },

        // ════════════════════════════════════════════════════════════════════
        // WORKSPACE MANAGEMENT
        // ════════════════════════════════════════════════════════════════════
        {
            "label": "setup",
            "detail": "Fresh-checkout setup: vcs import + pixi install",
            "type": "shell",
            "command": "pixi run setup",
            "problemMatcher": []
        },
        {
            "label": "export repos",
            "detail": "Pin current checkouts back into repos/*.repos",
            "type": "shell",
            "command": "pixi run export-repos",
            "problemMatcher": []
        },
        {
            "label": "new package (cmake)",
            "detail": "Create new ament_cmake package",
            "type": "shell",
            "command": "pixi run ros2 pkg create --destination-directory src/action --build-type ament_cmake ${input:packageName}",
            "problemMatcher": []
        },
        {
            "label": "new package (python)",
            "detail": "Create new ament_python package",
            "type": "shell",
            "command": "pixi run ros2 pkg create --destination-directory src/action --build-type ament_python ${input:packageName}",
            "problemMatcher": []
        },

        // ════════════════════════════════════════════════════════════════════
        // LEROBOT / ML WORKFLOW
        // ════════════════════════════════════════════════════════════════════
        {
            "label": "convert bags to lerobot",
            "detail": "Convert ROS2 bags to LeRobot dataset format (sequential)",
            "type": "shell",
            "command": "pixi run convert-bags --raw-dir ${input:bagsDir} --contract ${input:contractPath} --repo-id ${input:repoId} --root ${input:datasetRoot}",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "convert bags to lerobot (parallel)",
            "detail": "Convert ROS2 bags using parallel shards",
            "type": "shell",
            "command": "pixi run convert-bags-parallel ${input:bagsDir} ${input:contractPath} ${input:repoId} ${input:datasetRoot} ${input:numShards}",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "train policy",
            "detail": "Train a LeRobot policy (extra args: --wandb, --lora, --gpus N, --pretrained ...)",
            "type": "shell",
            "command": "pixi run train --dataset ${input:datasetRepoId} --policy ${input:policyType} --repo ${input:trainedPolicyRepoId} --output-dir ${input:trainOutputDir} --batch-size ${input:batchSize} --steps ${input:trainingSteps} --save-freq ${input:saveFreq} ${input:extraTrainArgs}",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "resume training",
            "detail": "Resume training from checkpoint",
            "type": "shell",
            "command": "pixi run resume-train --config_path=${input:checkpointPath}/pretrained_model/train_config.json",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "upload trained policy",
            "detail": "Upload trained policy checkpoint to HuggingFace Hub",
            "type": "shell",
            "command": "pixi run hf upload ${input:trainedPolicyRepoId} ${input:checkpointPath}/pretrained_model",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ],

    "inputs": [
        {
            "id": "buildMixin",
            "type": "pickString",
            "description": "Select build configuration (registered from .colcon/mixin)",
            "options": [
                {"label": "dev - Development (debug, no tests)", "value": "dev"},
                {"label": "debug - Debug build with full symbols", "value": "debug"},
                {"label": "release - Optimized release", "value": "release"},
                {"label": "rel-with-deb-info - Release with debug info", "value": "rel-with-deb-info"},
                {"label": "test - Build with tests enabled", "value": "test"},
                {"label": "asan - AddressSanitizer", "value": "asan"},
                {"label": "tsan - ThreadSanitizer", "value": "tsan"},
                {"label": "coverage - Code coverage", "value": "coverage"}
            ],
            "default": "dev"
        },
        {
            "id": "packageName",
            "type": "promptString",
            "description": "Package name",
            "default": "rosetta"
        },
        {
            "id": "bagsDir",
            "type": "promptString",
            "description": "Directory containing ROS2 bag recordings",
            "default": "${workspaceFolder}/datasets/bags"
        },
        {
            "id": "contractPath",
            "type": "promptString",
            "description": "Path to Rosetta contract YAML",
            "default": "${workspaceFolder}/src/action/rosetta/contracts/so_101.yaml"
        },
        {
            "id": "repoId",
            "type": "promptString",
            "description": "Dataset name (or HuggingFace repo_id like 'my-org/my-dataset')",
            "default": "so_101_dataset"
        },
        {
            "id": "datasetRoot",
            "type": "promptString",
            "description": "Parent directory for LeRobot datasets",
            "default": "${workspaceFolder}/datasets/lerobot"
        },
        {
            "id": "numShards",
            "type": "pickString",
            "description": "Number of parallel shards (more = faster but uses more CPU/RAM)",
            "options": ["2", "4", "6", "8"],
            "default": "4"
        },
        {
            "id": "datasetRepoId",
            "type": "promptString",
            "description": "Dataset repo ID (local path or HuggingFace repo like 'my-org/my-dataset')",
            "default": ""
        },
        {
            "id": "policyType",
            "type": "pickString",
            "description": "Policy architecture to train",
            "options": [
                {"label": "ACT - Action Chunking Transformer (recommended for beginners)", "value": "act"},
                {"label": "Diffusion Policy - For complex multi-modal tasks", "value": "diffusion"},
                {"label": "SmolVLA - Efficient VLA (use with LoRA)", "value": "smolvla"},
                {"label": "Pi0 - Physical Intelligence π₀ (use with LoRA)", "value": "pi0"},
                {"label": "Pi0Fast - Fast π₀ variant (use with LoRA)", "value": "pi0fast"},
                {"label": "Pi0.5 - π₀.₅ with open-world generalization", "value": "pi05"},
                {"label": "NVIDIA GR00T N1.5 - Humanoid foundation model", "value": "gr00t_n1"},
                {"label": "X-VLA - Soft-Prompted cross-embodiment VLA", "value": "xvla"},
                {"label": "WALL-OSS - Embodied foundation model", "value": "wall_x"},
                {"label": "VQ-BeT - Vector Quantized Behavior Transformer", "value": "vqbet"},
                {"label": "TDMPC - Temporal Difference MPC", "value": "tdmpc"}
            ],
            "default": "act"
        },
        {
            "id": "trainedPolicyRepoId",
            "type": "promptString",
            "description": "Output policy name (e.g., 'my_act_policy' or HuggingFace 'my-org/my-policy')",
            "default": "my_trained_policy"
        },
        {
            "id": "trainOutputDir",
            "type": "promptString",
            "description": "Output directory for training artifacts",
            "default": "${workspaceFolder}/models"
        },
        {
            "id": "batchSize",
            "type": "pickString",
            "description": "Training batch size (reduce if OOM)",
            "options": ["4", "8", "16", "32", "64", "128"],
            "default": "32"
        },
        {
            "id": "trainingSteps",
            "type": "promptString",
            "description": "Number of training steps",
            "default": "100000"
        },
        {
            "id": "saveFreq",
            "type": "promptString",
            "description": "Save a checkpoint every N training steps",
            "default": "10000"
        },
        {
            "id": "extraTrainArgs",
            "type": "promptString",
            "description": "Extra train args (e.g. '--wandb --lora --gpus 2 --pretrained default'; blank for none)",
            "default": "--wandb"
        },
        {
            "id": "checkpointPath",
            "type": "promptString",
            "description": "Path to checkpoint directory (e.g., models/act/my_run/checkpoints/last)",
            "default": ""
        }
    ]
}
