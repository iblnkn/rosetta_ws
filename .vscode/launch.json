{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.pixi/envs/default/bin/python"
        },
        {
            "name": "ROS2: Rosetta Client",
            "type": "ros2",
            "request": "launch",
            "target": "${workspaceFolder}/src/action/rosetta/launch/rosetta_client_launch.py",
            "env": {
                "RMW_IMPLEMENTATION": "rmw_zenoh_cpp"
            }
        },
        {
            "name": "ROS2: Episode Recorder",
            "type": "ros2",
            "request": "launch",
            "target": "${workspaceFolder}/src/action/rosetta/launch/episode_recorder_launch.py",
            "env": {
                "RMW_IMPLEMENTATION": "rmw_zenoh_cpp"
            }
        },
        {
            "name": "ROS2: Attach to Node",
            "type": "ros2",
            "request": "attach"
        },
        {
            "name": "(gdb) Launch (merge-install)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/install/lib/${input:package}/${input:program}",
            "args": [],
            "preLaunchTask": "build",
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "package",
            "type": "promptString",
            "description": "Package name",
            "default": "rosetta"
        },
        {
            "id": "program",
            "type": "promptString",
            "description": "Program name"
        }
    ]
}
