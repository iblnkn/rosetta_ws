repositories:
  # Stock upstream lerobot at the v0.6.0 release. The obs_similarity_atol
  # delta lives on the local branch feature/add_obs_similarity_atol (rebased
  # onto v0.6.0, PR-ready); until it lands upstream, the async-inference
  # obs-similarity filter is hardcoded on (atol 1.0) in stock lerobot — see
  # params/rosetta_client.yaml.
  lerobot:
    type: git
    url: https://github.com/huggingface/lerobot.git
    version: v0.6.0
